# Salin file ini jadi .env lalu isi nilainya.
#   cp .env.example .env

# --- Server HTTP -------------------------------------------------------
# Port untuk server QR. Railway mengisi PORT otomatis, tidak perlu diubah.
# Lokal: kosongkan atau isi 3000.
PORT=

# OPSIONAL. Token untuk mengamankan halaman /qr. Kalau kosong, token dibuat
# acak tiap boot dan hanya muncul di log. Isi kalau mau URL yang tetap.
QR_TOKEN=

# --- Provider AI -------------------------------------------------------
# Multi-provider: daftar nama dipisah koma, URUTAN = urutan fallback.
# Pertama dicoba dulu; kalau gagal (error, timeout), percobaan berikutnya
# pindah ke provider di belakangnya, lalu putar kembali ke awal.
AI_PROVIDERS=google,cloudflare,groq,openrouter

# Setiap nama di AI_PROVIDERS butuh tiga variabel: AI_<NAMA>_BASE_URL,
# AI_<NAMA>_API_KEY, AI_<NAMA>_MODEL. Semua harus OpenAI-compatible
# (endpoint /chat/completions). Provider yang API_KEY-nya kosong dilewati,
# jadi cadangan yang belum punya kunci tidak bikin bot menolak start.
#
# Google AI Studio (utama) — endpoint OpenAI-compatible-nya:
AI_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_GOOGLE_API_KEY=
AI_GOOGLE_MODEL=gemini-2.5-flash

# Cloudflare Workers AI (cadangan 1) — ganti ACCOUNT_ID dengan ID akunmu:
AI_CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/ACCOUNT_ID/ai/v1
AI_CLOUDFLARE_API_KEY=
AI_CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# Groq (cadangan 2):
AI_GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_GROQ_API_KEY=
AI_GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (cadangan 3):
AI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_OPENROUTER_API_KEY=
AI_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OPSIONAL per provider. Model untuk pesan bergambar. Kalau tidak ada
# provider punya VISION_MODEL, pesan bergambar memakai chain chat di atas.
AI_GOOGLE_VISION_MODEL=gemini-2.5-flash
# AI_CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct

# --- Bisnis ------------------------------------------------------------
BUSINESS_NAME=

# Nomor WhatsApp kamu untuk menerima eskalasi. Format internasional tanpa
# tanda plus: 62812xxxxxxx
OWNER_NUMBER=

# --- Siapa yang boleh chat ---------------------------------------------
# PUBLIC    = semua orang (default untuk bot CS)
# WHITELIST = hanya nomor di WHITELIST
ACCESS_MODE=PUBLIC
WHITELIST=

# --- Batas dan jeda ----------------------------------------------------
# Angka-angka ini titik awal, bukan hasil pengukuran. Jalankan seminggu,
# lihat data/log.jsonl, baru setel.
#
# Batas masuk = anti-spam. Pelanggan normal kirim 3-8 pesan beruntun.
RATE_IN_MAX=20
RATE_IN_WINDOW_SEC=60
# Lama nomor didiamkan setelah melewati batas masuk.
RATE_IN_COOLDOWN_MIN=5

# Batas keluar = perlindungan dari pemblokiran nomor. Yang terlihat bot
# itu pesan yang DIKIRIM, bukan yang diterima. Kalau batas ini tercapai,
# pengiriman ditunda, bukan dibuang.
RATE_OUT_MAX=15
RATE_OUT_WINDOW_SEC=60

# Jeda mengumpulkan pesan beruntun jadi satu balasan.
#
# 3 detik terlalu pendek. Pelanggan yang mengirim dua kalimat berurutan butuh
# beberapa detik untuk mengetik yang kedua, dan dengan 3 detik pesan keduanya
# datang setelah jendela tutup - bot menjawab dua kali, dan balasan kedua
# sering tidak nyambung karena tidak melihat kalimat pertama.
#
# Ini juga jadi lama tunggu balasan pertama, jadi kalau terasa lambat,
# turunkan sedikit dulu sebelum menaikkan.
DEBOUNCE_SEC=8
# Jeda antar potongan kalau balasan panjang harus dipecah.
CHUNK_DELAY_SEC=1
# Gambar lebih besar dari ini dilewati.
MAX_IMAGE_MB=5